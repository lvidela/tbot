[Unit]
Description=Deterministic Kraken market monitor (observe + escalate; never trades)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/lisandro
Environment=PATH=/home/lisandro/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/lisandro/scripts/monitor.py
Restart=always
RestartSec=15
StandardOutput=append:/home/lisandro/logs/monitor.out
StandardError=append:/home/lisandro/logs/monitor.err
# Hardening: the monitor needs only its own repo and outbound HTTPS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/lisandro
ProtectHome=false

[Install]
WantedBy=default.target
