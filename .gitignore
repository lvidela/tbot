# Credentials -- these live ONLY on the VM and must never reach this repository.
env
.env
.env.*
!.env.example
*.key
*.pem
*.secret
*.p12
id_rsa*
id_ed25519*
.credentials.json
.netrc

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Runtime state -- regenerated by the monitor on start; not research data.
data/monitor_state.json
data/universe.json
data/escalation_context.json
data/cache/
*.lock
*.pid
*.tmp

# Runtime logs -- continuously growing process output, not audit records.
# NOTE: logs/activity.jsonl and logs/journal.md ARE audit records and ARE committed.
logs/monitor.out
logs/monitor.err
logs/cache_build.log
logs/claude_sessions/

# Local agent state (only .claude/settings.json is intentionally versioned)
.claude/*
!.claude/settings.json
